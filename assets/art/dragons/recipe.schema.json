{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dragon Valley dragon recipe",
  "description": "Input of the parametric dragon rig (src/app/art/dragon). Validated strictly by parseRecipe.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "kind",
    "mnemonic",
    "colors",
    "build",
    "horns",
    "ears",
    "wings",
    "tail",
    "spikes",
    "crest",
    "markings",
    "features",
    "egg"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "table",
        "special",
        "finale",
        "guide"
      ]
    },
    "table": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "mnemonic": {
      "type": "string"
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body",
        "belly",
        "wing",
        "horn",
        "accent",
        "iris",
        "cheek"
      ],
      "properties": {
        "body": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "belly": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "wing": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "horn": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "iris": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "cheek": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "shade": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent2": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chub",
        "head",
        "snout",
        "body"
      ],
      "properties": {
        "chub": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "head": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.2
        },
        "snout": {
          "type": "number",
          "minimum": 0.7,
          "maximum": 1.3
        },
        "body": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.2
        }
      }
    },
    "horns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "count",
        "length"
      ],
      "properties": {
        "style": {
          "type": "string",
          "enum": [
            "curved",
            "straight",
            "nub",
            "cloud",
            "crystal",
            "crescent",
            "ram",
            "branch",
            "none"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "length": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 1.6
        }
      }
    },
    "ears": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "size"
      ],
      "properties": {
        "style": {
          "type": "string",
          "enum": [
            "frill",
            "fin",
            "leaf",
            "petal",
            "cloud",
            "shell",
            "round",
            "none"
          ]
        },
        "size": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 1.6
        }
      }
    },
    "wings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "count",
        "size"
      ],
      "properties": {
        "style": {
          "type": "string",
          "enum": [
            "bat",
            "cloud",
            "fin",
            "leaf",
            "petal",
            "crystal",
            "shell",
            "stone",
            "gear",
            "feather"
          ]
        },
        "count": {
          "enum": [
            2,
            4
          ]
        },
        "size": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 1.4
        }
      }
    },
    "tail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "tip",
        "length"
      ],
      "properties": {
        "count": {
          "enum": [
            1,
            2
          ]
        },
        "tip": {
          "type": "string",
          "enum": [
            "spade",
            "cloud",
            "fin",
            "clover",
            "flower",
            "clock-hand",
            "flame",
            "heart",
            "crystal",
            "star",
            "pearl",
            "rock",
            "gear",
            "tuft"
          ]
        },
        "length": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1.5
        },
        "curl": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 1.3
        }
      }
    },
    "spikes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "where",
        "count"
      ],
      "properties": {
        "style": {
          "type": "string",
          "enum": [
            "round",
            "flame",
            "crystal",
            "leaf",
            "stone",
            "none"
          ]
        },
        "where": {
          "type": "string",
          "enum": [
            "tail",
            "head",
            "none"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        }
      }
    },
    "crest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "count"
      ],
      "properties": {
        "style": {
          "type": "string",
          "enum": [
            "none",
            "sun",
            "flower",
            "crown10",
            "shell",
            "cloud-tuft",
            "flames"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        }
      }
    },
    "markings": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "belly-plates",
          "rainbow-belly",
          "clock-belly",
          "snowflake-belly",
          "ten-frame-stars",
          "clover-spots",
          "mirror-belly",
          "bubble-spots",
          "zero-medallion",
          "place-value",
          "moss",
          "gears",
          "freckles",
          "scales",
          "counting-dots",
          "polka-dots",
          "plus-belly",
          "minus-belly"
        ]
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "reflection",
          "smoke-ring",
          "bubbles",
          "pearl-pile",
          "shine",
          "cloud-body",
          "wind-key",
          "beard",
          "spectacles",
          "bushy-brows",
          "shawl",
          "sparkle-cheeks",
          "rock-body",
          "number-line",
          "berry-row",
          "buck-teeth"
        ]
      }
    },
    "egg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "accent",
        "pattern"
      ],
      "properties": {
        "base": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "pattern": {
          "type": "string",
          "enum": [
            "clouds",
            "shine",
            "waves",
            "clovers",
            "flowers",
            "sun",
            "flames",
            "rainbow",
            "snowflake",
            "stars",
            "crown",
            "scallops",
            "speckles",
            "gears",
            "polka",
            "hops",
            "berries",
            "spots"
          ]
        }
      }
    }
  }
}
